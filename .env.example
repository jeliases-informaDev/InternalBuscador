# Copiar a ".env" (que NO se versiona) y completar. Nunca subir el .env real.

# --- Base de datos REAL (la de la oficina). Usa un usuario SQL propio de la aplicación, no uno personal.
ConnectionStrings__DefaultConnection=Server=192.168.1.17;Database=Buscador;User Id=USUARIO_APP;Password=CLAVE_APP;TrustServerCertificate=True;

# --- JWT: clave aleatoria de 32+ caracteres.  Generar:  openssl rand -base64 64
Jwt__Key=
Jwt__Issuer=BuscadorInterno
Jwt__Audience=BuscadorInternoUsuarios
Jwt__ExpiresInMinutes=15

# --- CORS: URL EXACTA del front en Vercel (sin barra final). Una línea por dominio.
Cors__Origins__0=https://tu-proyecto.vercel.app
# Cors__Origins__1=https://buscador.tudominio.com

# --- Correo (invitaciones y recuperación de contraseña)
Email__Host=
Email__Port=587
Email__EnableSsl=true
Email__User=
Email__Password=
Email__From=no-reply@informaperu.com

# --- Enlace que llega en los correos: la pantalla de restablecer del front
Recuperacion__FrontendResetUrl=https://tu-proyecto.vercel.app/auth/reset-password

# --- RENIEC (solo consulta individual)
Reniec__Token=

# --- Puerto local donde queda la API (solo localhost). Cambiarlo si el 8080 de la máquina está ocupado.
API_PUERTO=8080

# --- Túnel de Cloudflare (solo si usa el perfil "tunel")
TUNNEL_TOKEN=
